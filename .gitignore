# Build output folder: compiled programs for each OS/CPU live here and can be rebuilt from source
dist/
bin/

# Compiled binaries on any OS (Linux has no extension, Windows uses .exe)
*.exe
*.test
*.out

# Go test coverage reports: generated files, not source code
coverage.txt
*.coverprofile

# Saved monitoring history (F10): must never reach GitHub, supports requirement S4
history/
*.history.json

# Saved performance test results (numbers about this machine): personal to each machine
performanceCompare/
# The name used by earlier versions (renamed on start-up); kept here so an old folder can never reach GitHub
PerformanceCompare/

# Remembered list of deleted models: personal to each machine
deletedHistory/

# Local user settings written by the app: personal to each machine
settings.json

# Environment files that might hold secrets such as tokens
.env

# Editor and OS clutter
.vscode/
.idea/
.DS_Store

# Stray files from saving a comparison with the browser (PDF and CSV): they must never reach GitHub
LLMsControlDock-comparison*
OllamaControlCenter-comparison*

# Developer regression test (local only, not part of the program)
regressionTest/
